# Copy to .env. Keep API credentials on Ubuntu, never in Lovable or VITE_*.
OPENAI_API_KEY=
ASTRA_MODEL=
# Optional for event-provided API access:
# OPENAI_BASE_URL=https://api.openai.com/v1
ASTRA_STRUCTURED_OUTPUTS=true

# Set to your installed Isaac Sim directory (contains python.sh).
ISAAC_SIM_PATH=
# Optional absolute path. Backend and simulator must use the same directory.
# JOBS_DIR=/absolute/path/to/sim-sketch-artist/jobs
PORT=8000

